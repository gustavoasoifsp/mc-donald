generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Cliente {
  id      Int      @id @default(autoincrement())
  nome    String
  email   String   @unique
  pedidos Pedido[]
}

model Pedido {
  id        Int     @id @default(autoincrement())
  descricao String
  valor     Float
  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id])
}